// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modello per i contatti dal form contatti
model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  // Attribuzione sorgente (prima visita della sessione)
  referrer    String?
  landingPage String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Lavorazione del lead (dal 07/10/2026): a che punto e', se e' buono,
  // perche' e' andato perso, appunti. "read" resta per compatibilita'.
  // stato: nuovo | contattato | appuntamento | cliente | perso
  stato        String    @default("nuovo")
  // qualita: buono | medio | scarso | spam
  qualita      String?
  motivo       String?
  note         String?
  contattatoAt DateTime?
  aggiornatoAt DateTime?
}

// Modello per gli ordini dal checkout
model Order {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  address     String?
  city        String?
  postalCode  String?
  country     String   @default("Deutschland")

  // Dettagli ordine
  items       Json
  totalPrice  Float

  // PayPal
  paypalOrderId String?
  paypalStatus  String?

  createdAt   DateTime @default(now())
  status      String   @default("pending") // pending, completed, cancelled
}

// Documenti generati: contratti + Rechnung (archivio)
model Document {
  id          String   @id @default(cuid())
  type        String   // "contract" | "rechnung"
  clientName  String
  serviceType String?  // pacchetto (per contratti)
  rechnungNr  String?  // numero fattura (per Rechnung)
  total       Float    @default(0)
  // Snapshot completo per ri-aprire/stampare il documento
  contractData Json?
  rechnungData Json?
  // PDF del contratto firmato (su carta, poi scansionato o stampato), per
  // averlo sempre a portata di mano dalla scheda Clienti. Dal 07/10/2026.
  pdf         Bytes?
  pdfNome     String?
  pdfCaricatoAt DateTime?
  createdAt   DateTime @default(now())
}

/// Preventivo contrattuale, stessa impostazione di DirezioneX: proposta e
/// contratto sono lo stesso documento. Firmato vale come accordo, e da li'
/// parte il ciclo acconto -> lavoro -> saldo.
///
/// Rispetto a DirezioneX mancano di proposito i campi della rete vendita
/// (collaboratori, commissioni, segnalazioni): qui vende solo Angelo.
model Preventivo {
  id             String    @id @default(cuid())
  numero         String    @unique // P-2026-001
  token          String    @unique // link pubblico di firma, 32 hex

  // --- committente ---
  clienteNome    String
  clienteEmail   String?
  clienteTelefono String?
  clienteIndirizzo String?
  // Partita IVA / Steuernummer: serve se il cliente fattura come azienda
  clientePiva    String?

  // --- documento ---
  oggetto        String?   // titolo del lavoro, in testa al documento
  premesse       String?   // testo introduttivo
  // [{descrizione, prezzo, quantita}]. Uno sconto e' una riga con prezzo
  // negativo: il totale resta la somma delle righe e si vede da dove viene.
  items          Json
  totale         Float
  // una tantum | mensile. I pacchetti coaching di Angelo sono quasi tutti
  // mensili (150 €/mese per 3, 6 o 12 mesi).
  periodicita    String    @default("una tantum")
  mesi           Int       @default(1) // durata per i pacchetti mensili
  importoNota    String?   // es. "IVA non esposta, § 19 UStG"
  articoli       Json?     // clausole [{titolo, testo}]
  lingua         String    @default("de") // de | it

  // --- stato del documento ---
  // inviato | firmato | scaduto | sostituito
  stato          String    @default("inviato")
  sostituitoDa   String?
  validoFino     DateTime?
  inviatoAt      DateTime?
  inviatoA       String?

  // --- firma del cliente ---
  firma          Bytes?    // png della firma disegnata
  firmatoNome    String?
  firmatoAt      DateTime?

  // --- soldi ---
  // Come in DirezioneX: la firma da sola non perfeziona. Il preventivo passa
  // a "firmato" quando il primo incasso risulta pagato.
  accontoPerc    Int       @default(50)
  accontoIncassato Float   @default(0)
  accontoIncassatoAt DateTime?

  // --- lavoro ---
  lavoro         String    @default("da iniziare") // da iniziare | in corso | consegnato | concluso
  lavoroNote     String?
  dataInizio     DateTime?
  dataFine       DateTime?

  pagamenti      Pagamento[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stato])
}

/// Richiesta di pagamento con link pubblico. Una riga per rata: l'acconto,
/// il saldo, oppure un canone mensile (una riga per mese).
model Pagamento {
  id           String     @id @default(cuid())
  token        String     @unique // link pubblico /pagamento/<token>

  preventivoId String?
  preventivo   Preventivo? @relation(fields: [preventivoId], references: [id], onDelete: SetNull)
  documento    String?    // numero del preventivo, anche se la riga resta orfana

  descrizione  String     // cosa sta pagando il cliente, in chiaro
  clienteNome  String
  clienteEmail String?

  importo      Float
  valuta       String     @default("EUR")
  // unica | acconto | rata | saldo | abbonamento
  tipo         String     @default("unica")
  rataNumero   Int?
  rateTotali   Int?
  scadenza     DateTime?

  // aperto | in corso | pagato | annullato
  stato        String     @default("aperto")
  provider     String?    // stripe | bonifico
  metodo       String?    // carta | sepa | bonifico | abbonamento
  providerRef  String?    // id sessione/subscription lato Stripe
  pagatoAt     DateTime?
  note         String?

  createdAt    DateTime   @default(now())

  @@index([stato])
  @@index([documento])
}

/// App clienti (dal 12/11/2026). Il coach scrive allenamento e alimentazione
/// giorno per giorno; il cliente apre /app, tocca il giorno e vede cosa fare.
/// E' la prova dentro FitPrimo di un prodotto da rivendere in white label:
/// `coach` dice di quale marchio e' il cliente (oggi solo "fitprimo"), cosi'
/// piu' avanti non serve un ALTER TABLE per separare i coach.
model AppCliente {
  id            String        @id @default(cuid())
  coach         String        @default("fitprimo")
  nome          String
  email         String?
  telefono      String?
  lingua        String        @default("de") // de | it
  obiettivo     String?       // lo vede anche il cliente, in testa all'app
  note          String?       // solo per il coach
  // 8 cifre: si scrive nell'app installata (su iPhone non vede i cookie di Safari)
  codice        String        @unique
  // link d'accesso /app/entra/<token>, 32 hex, da mandare su WhatsApp
  token         String        @unique
  attivo        Boolean       @default(true)
  ultimoAccesso DateTime?
  // contratto FitPrimo collegato (Preventivo.id): abbonamento, rate, ore incluse
  preventivoId  String?
  giornate      AppGiornata[]
  prenotazioni  AppPrenotazione[]
  misure        AppMisura[]
  messaggi      AppMessaggio[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([coach])
}

/// Un giorno del piano di un cliente. `data` e' il giorno di calendario a
/// Colonia come testo (YYYY-MM-DD): niente fusi orari che spostano i giorni.
model AppGiornata {
  id            String     @id @default(cuid())
  clienteId     String
  cliente       AppCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  data          String
  riposo        Boolean    @default(false)
  allenamento   Json?      // Allenamento in src/lib/app-coaching/tipi.ts
  alimentazione Json?      // Alimentazione in src/lib/app-coaching/tipi.ts
  notaCoach     String?
  // --- risposta del cliente ---
  fatto         Boolean    @default(false)
  fattoAt       DateTime?
  fatica        Int?       // 1-5
  feedback      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([clienteId, data])
  @@index([data])
}

/// Disponibilita' settimanale del coach per le ore 1:1 (dal 13/11/2026).
model AppSlot {
  id        String   @id @default(cuid())
  coach     String   @default("fitprimo")
  giorno    Int      // 0 = lunedi' ... 6 = domenica
  inizio    String   // "07:00"
  fine      String   // "08:00"
  luogo     String?
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([coach])
}

/// Giorni in cui il coach non prende prenotazioni (ferie, malattia).
model AppChiusura {
  id        String   @id @default(cuid())
  coach     String   @default("fitprimo")
  data      String   // YYYY-MM-DD
  nota      String?
  createdAt DateTime @default(now())

  @@unique([coach, data])
}

/// Ora 1:1 prenotata dal cliente (o dal coach per lui).
/// Nel DB c'e' anche un indice unico parziale (coach, data, inizio) sulle
/// prenotazioni attive: due clienti non possono prendere la stessa ora.
model AppPrenotazione {
  id          String     @id @default(cuid())
  coach       String     @default("fitprimo")
  clienteId   String
  cliente     AppCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  data        String     // YYYY-MM-DD
  inizio      String     // "07:00"
  fine        String     // "08:00"
  luogo       String?
  tipo        String     @default("inclusa") // inclusa | extra
  stato       String     @default("confermata") // confermata | da pagare | svolta | annullata
  pagamentoId String?    // Pagamento dell'ora extra, se va pagata
  nota        String?
  annullataAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([coach, data])
  @@index([clienteId])
}

/// Misure del corpo segnate dal cliente (peso, circonferenze).
model AppMisura {
  id        String     @id @default(cuid())
  clienteId String
  cliente   AppCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  data      String     // YYYY-MM-DD
  peso      Float?     // kg
  vita      Float?     // cm
  fianchi   Float?
  petto     Float?
  braccio   Float?
  coscia    Float?
  grasso    Float?     // %
  nota      String?
  createdAt DateTime   @default(now())

  @@index([clienteId, data])
}

/// Messaggi tra cliente e coach dentro l'app.
model AppMessaggio {
  id        String     @id @default(cuid())
  clienteId String
  cliente   AppCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  daCoach   Boolean
  testo     String
  lettoAt   DateTime?
  createdAt DateTime   @default(now())

  @@index([clienteId, createdAt])
}
